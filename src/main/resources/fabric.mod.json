{
   "schemaVersion": 1,
   "id": "jineric",
   "name": "Jineric Mod",
   "version": "${version}",
   "description": "A gameplay mod focussed on improving the vanilla experience",
   "authors": [
      "Jiingy"
   ],
   "contact": {
      "homepage": "https://modrinth.com/mod/jineric-mod",
      "issues": "https://github.com/Jiingy/Jineric-Mod/issues",
      "sources": "https://github.com/Jiingy/Jineric-Mod"
   },
   "license": "GPL-3.0-only",
   "icon": "assets/jineric/icon.png",
   "environment": "*",
   "entrypoints": {
      "main": [
         "jingy.jineric.base.JinericMain"
      ],
      "client": [
         "net.jineric.jineric_mod.JinericClientMain"
      ],
      "fabric-datagen": [
         "net.jineric.jineric_mod.data.generation.JinericDataGeneration"
      ],
      "preLaunch": [
         "jingy.jineric.base.plugins.JinericPreLaunch"
      ],
      "terrablender": [
         "jingy.jineric.base.plugins.TerraBlenderPlugin"
      ],
      "mm:early_risers": [
         "jingy.jineric.base.plugins.EarlyRiser"
      ]
   },
   "mixins": [
      "jineric.mixins.json",
      {
         "environment": "client",
         "config": "jineric.client.mixins.json"
      }
   ],
   "depends": {
      "fabricloader": ">=0.17.3",
      "minecraft": "~1.21.10",
      "java": ">=21",
      "fabric-api": "*"
   },
   "accessWidener": "jineric.accesswidener",
   "suggests": {
      "another-mod": "*"
   },
   "custom": {
      "modmenu": {
        "inks": {
          "modmenu.discord": "https://discord.gg/VPqDtBc"
        }
     },
     "loom:injected_interfaces": {
        "net/minecraft/class_10260": [
           "net/jineric/jineric_mod/access/RecipeBookScreenAccess"
        ],
        "net/minecraft/class_5794": [
           "jingy/jineric/access/BlockFamilyAccess"
        ],
        "net/minecraft/class_5794\u0024class_5795": [
           "jingy/jineric/access/BlockFamilyBuilderAccess"
        ],
        "net/minecraft/class_2446": [
           "jingy/jineric/access/RecipeGeneratorAccess"
        ],
        "net/minecraft/class_1799": [
           "jingy/jineric/access/ItemStackAccess"
        ],
        "net/minecraft/class_1792\u0024class_1793": [
           "jingy/jineric/access/ItemSettingsAccess"
        ],
        "net/minecraft/class_8074": [
           "jingy/jineric/access/SmithingTransformRecipeJsonBuilderAccess"
        ],
        "net/minecraft/class_3924": [
           "net/minecraft/class_3908",
           "net/minecraft/class_1275",
           "net/minecraft/class_1263"
        ]
     }
   }
}
