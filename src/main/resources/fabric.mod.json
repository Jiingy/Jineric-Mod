{
   "schemaVersion": 1,
   "id": "jineric",
   "name": "Jineric Mod",
   "version": "${version}",
   "description": "A gameplay mod focussed on improving the vanilla experience",
   "authors": [
      "Jiingy"
   ],
   "contact": {
      "homepage": "https://modrinth.com/mod/jineric-mod",
      "issues": "https://github.com/Jiingy/Jineric-Mod/issues",
      "sources": "https://github.com/Jiingy/Jineric-Mod"
   },
   "license": "GPL-3.0-only",
   "icon": "assets/jineric/icon.png",
   "environment": "*",
   "entrypoints": {
      "main": [
         "jingy.jineric.base.JinericMain"
      ],
      "client": [
         "net.jineric.jineric_mod.JinericClientMain"
      ],
      "fabric-datagen": [
         "net.jineric.jineric_mod.data.generation.JinericDataGeneration"
      ],
      "preLaunch": [
         "jingy.jineric.base.plugins.JinericPreLaunch"
      ],
      "terrablender": [
         "jingy.jineric.base.plugins.TerraBlenderPlugin"
      ],
      "mm:early_risers": [
         "jingy.jineric.base.plugins.EarlyRiser"
      ]
   },
   "mixins": [
      "jineric.mixins.json",
      {
         "environment": "client",
         "config": "jineric.client.mixins.json"
      }
   ],
   "depends": {
      "fabricloader": ">=0.17.3",
      "minecraft": "~1.21.11",
      "java": ">=21",
      "fabric-api": "*"
   },
   "accessWidener": "jineric.accesswidener",
   "suggests": {
      "another-mod": "*"
   },
   "custom": {
      "modmenu": {
        "inks": {
          "modmenu.discord": "https://discord.gg/VPqDtBc"
        }
     },
     "loom:injected_interfaces": {
        "net/minecraft/client/gui/screens/inventory/AbstractRecipeBookScreen": [
           "net/jineric/jineric_mod/access/JmAbstractRecipeBookScreen"
        ],
        "net/minecraft/data/BlockFamily": [
           "jingy/jineric/access/JmBlockFamily"
        ],
        "net/minecraft/data/BlockFamily$Builder": [
           "jingy/jineric/access/JmBlockFamilyBuilder"
        ],
        "net/minecraft/data/recipes/RecipeProvider": [
           "jingy/jineric/access/JmRecipeProvider"
        ],
        "net/minecraft/world/item/ItemStack": [
           "jingy/jineric/access/JmItemStack"
        ],
        "net/minecraft/world/item/Item$Properties": [
           "jingy/jineric/access/JmJmItemProperties"
        ],
        "net/minecraft/data/recipes/SmithingTransformRecipeBuilder": [
           "jingy/jineric/access/JmSmithingTransformRecipeBuilder"
        ],
        "net/minecraft/world/level/block/entity/CampfireBlockEntity": [
           "net/minecraft/world/level/block/entity/MenuProvider",
           "net/minecraft/world/Nameable",
           "net/minecraft/world/Container"
        ]
     }
   }
}
